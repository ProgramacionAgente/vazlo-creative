---
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import rawContact from '../content/pages/contact.json';
import rawSite from '../content/settings/site.json';
import { highlightHeading } from '../lib/highlight';
import { resolveContentTokens } from '../lib/content-tokens';

export const prerender = true;

const site = resolveContentTokens(rawSite, { brand: rawSite.brand });
const contact = resolveContentTokens(rawContact, { brand: site.brand });
const { phone, email, formEndpoint } = site.contact;
const phoneHref = `tel:${phone.replace(/[^+\d]/g, '')}`;
const formAction = formEndpoint || `mailto:${email}`;
---
<Layout title={contact.title} description={contact.heroParagraph} image={contact.heroImage}>
  <section class="mesh-bg relative pt-32 pb-section-py-sm overflow-hidden">
    <div class="absolute top-1/4 right-1/3 w-72 h-72 rounded-full bg-accent/5 blur-[100px] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <span class="tag-cyber mb-5 inline-flex"><span class="material-symbols-outlined text-sm" aria-hidden="true">mail</span>{contact.heroTag}</span>
          <h1 class="font-display text-display-hero-mobile md:text-5xl font-extrabold mb-5" set:html={highlightHeading(contact.heroHeading, contact.heroHighlight)}></h1>
          <p class="text-body-lg text-text-secondary">{contact.heroParagraph}</p>
        </div>
        <div class="reveal">
          <div class="glass card-cyber rounded-2xl overflow-hidden animate-float">
            <ResponsiveImage src={contact.heroImage} alt={contact.heroImageAlt} width={720} height={720} sizes="(min-width: 768px) 50vw, 100vw" class="w-full aspect-square object-cover" priority />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-bg-depth py-section-py-sm md:py-section-py-lg">
    <div class="max-w-container-max mx-auto px-gutter">
      <div class="grid md:grid-cols-2 gap-14 items-start">
        <div class="reveal">
          <h2 class="font-display text-headline-lg-mobile md:text-headline-md mb-4">{contact.formInfoHeading}</h2>
          <p class="text-text-secondary text-body-md mb-8 leading-relaxed">{contact.formInfoText}</p>
          <div class="space-y-5 mb-10">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-accent text-base" aria-hidden="true">mail</span></div>
              <div><p class="text-text-dim text-xs uppercase tracking-widest font-display font-semibold mb-0.5">Email</p><a href={`mailto:${email}`} class="text-text-primary text-sm hover:text-accent transition-colors">{email}</a></div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center flex-shrink-0"><span class="material-symbols-outlined text-accent text-base" aria-hidden="true">call</span></div>
              <div><p class="text-text-dim text-xs uppercase tracking-widest font-display font-semibold mb-0.5">Teléfono</p><a href={phoneHref} class="text-text-primary text-sm hover:text-accent transition-colors">{phone}</a></div>
            </div>
          </div>
        </div>

        <div class="reveal">
          <div class="glass lumen-border rounded-2xl p-6 sm:p-8">
            <form id="contact-form" class="space-y-5" action={formAction} method="post" data-endpoint={formEndpoint} data-recipient={email} aria-describedby="form-help form-status">
              <input type="hidden" name="_subject" value={`Nueva consulta desde ${site.brand}`} />
              <div class="hidden" aria-hidden="true"><label for="contact-company">No completar</label><input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" /></div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="contact-name" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">Nombre completo <span class="text-accent" aria-hidden="true">*</span></label>
                  <input id="contact-name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" class="input-cyber" required />
                </div>
                <div>
                  <label for="contact-email" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">Email corporativo <span class="text-accent" aria-hidden="true">*</span></label>
                  <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="tu@empresa.com" class="input-cyber" required />
                </div>
              </div>
              <div>
                <label for="contact-service" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">Motivo de consulta <span class="text-accent" aria-hidden="true">*</span></label>
                <select id="contact-service" name="service" class="input-cyber" required><option value="" disabled selected>Selecciona un servicio</option>{contact.serviceOptions.map((option) => <option value={option.value}>{option.label}</option>)}</select>
              </div>
              <div>
                <label for="contact-message" class="block text-text-secondary text-xs uppercase tracking-widest font-display font-semibold mb-2">Mensaje <span class="text-accent" aria-hidden="true">*</span></label>
                <textarea id="contact-message" name="message" rows="4" placeholder="Cuéntanos sobre tu proyecto..." class="input-cyber resize-none" required></textarea>
              </div>
              <p id="form-help" class="text-text-dim text-xs leading-relaxed">{formEndpoint ? 'Tus datos se enviarán de forma segura. Te responderemos lo antes posible.' : 'Modo plantilla: al enviar se abrirá tu aplicación de correo. Configura formEndpoint para activar el envío directo.'}</p>
              <p id="form-status" class="form-status hidden" role="status" aria-live="polite"></p>
              <button id="contact-submit" type="submit" class="btn-cyber-solid w-full justify-center magnetic press"><span data-submit-label>{contact.submitLabel}</span></button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mesh-bg-alt py-16">
    <div class="max-w-container-max mx-auto px-gutter flex justify-center">
      <div class="glass lumen-border rounded-2xl px-8 py-5 flex items-center gap-4"><span class="material-symbols-outlined text-accent text-2xl" aria-hidden="true">location_on</span><div><p class="font-display font-bold text-text-primary">{contact.mapHeading}</p><p class="text-text-secondary text-sm">{contact.mapText}</p></div></div>
    </div>
  </section>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const submitLabel = submitButton?.querySelector('[data-submit-label]');
  const formStatus = document.getElementById('form-status');
  const showStatus = (message: string, state: 'success' | 'error') => {
    if (!formStatus) return;
    formStatus.textContent = message;
    formStatus.dataset.state = state;
    formStatus.classList.remove('hidden');
  };

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(contactForm);
    if (String(data.get('company') || '')) return;
    const endpoint = contactForm.dataset.endpoint;
    const recipient = contactForm.dataset.recipient;

    if (!endpoint) {
      if (!recipient) return;
      const subject = `Consulta sobre ${String(data.get('service') ?? '')}`;
      const body = [`Nombre: ${String(data.get('name') ?? '')}`, `Email: ${String(data.get('email') ?? '')}`, `Servicio: ${String(data.get('service') ?? '')}`, '', String(data.get('message') ?? '')].join('\n');
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      return;
    }

    submitButton?.setAttribute('disabled', '');
    submitButton?.setAttribute('aria-busy', 'true');
    if (submitLabel) submitLabel.textContent = 'Enviando…';
    formStatus?.classList.add('hidden');

    try {
      const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      contactForm.reset();
      showStatus('Mensaje enviado. Gracias, te contactaremos pronto.', 'success');
    } catch {
      showStatus(`No pudimos enviar el mensaje. Escríbenos directamente a ${recipient}.`, 'error');
    } finally {
      submitButton?.removeAttribute('disabled');
      submitButton?.removeAttribute('aria-busy');
      if (submitLabel) submitLabel.textContent = 'Enviar mensaje';
    }
  });
</script>
</Layout>
